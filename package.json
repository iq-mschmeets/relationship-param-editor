{
  "name": "relationship-param-editor",
  "version": "1.0.0",
  "description": "Editor for relationship properties, as web components.",
  "main": "./src/index.js",
  "type": "module",
  "files": [
    "src",
    "css"
  ],
  "scripts": {
    "clean": "rimraf lib dist coverage",
    "check": "npm run lint",
    "lint": "eslint --ext=js src",
    "build:css": "node-sass css/styles.scss dist/style.css",
    "build": "npm run build:css",
    "test": "echo 'Tests deferred for web components'",
    "prepublish": "npm run clean && npm run check && npm run build"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "es2020",
    "esm"
  ],
  "author": "Tay Yang Shun <tay.yang.shun@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yangshun/react-component-starter/issues"
  },
  "homepage": "https://github.com/yangshun/react-component-starter",
  "devDependencies": {
    "eslint": "^8.0.0",
    "node-sass": "^8.0",
    "rimraf": "^2.5.4"
  },
  "dependencies": {}
}
